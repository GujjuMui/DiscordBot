# Discord Bot Environment Configuration Example
# Copy this file to .env and fill in your production values.
# Never commit a real .env — it holds the bot token and secrets.

# Discord Bot Credentials (required)
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
# REQUIRED — the bot owner's Discord user ID. There is no hardcoded
# fallback: if this is unset, owner-only commands have no owner
# (fail closed) and config.js logs an error at startup.
BOT_OWNER_ID=your_discord_user_id_here

# Guild Configuration
# Comma-separated guild IDs the bot is allowed to run in.
# Leave empty to allow all guilds (unrestricted).
ALLOWED_GUILD_IDS=id1,id2,id3

# Feature Flags (all default to true when unset)
ENABLE_TICKETS=true
ENABLE_TRYOUTS=true
ENABLE_VERIFICATION=true
ENABLE_MODERATION=true
ENABLE_CHANNEL_MANAGER=true
ENABLE_BROADCAST=true

# Database (required)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Cloudinary Image Hosting
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Folder prefix for uploaded images, e.g. "hornet/cards".
CLOUDINARY_FOLDER_PREFIX=hornet

# --- Guild IDs, roles, channels and clan branding ---
# These do NOT live in .env. They live in config/guild.json
# (copy config/guild.example.json to start), and can be overridden
# per guild in MongoDB via the BotSettings collection
# (see config/configLoader.js). A few keys can also be overridden
# here, e.g.:
# CHANNEL_WELCOME=your_welcome_channel_id
# CHANNEL_MAIN_WELCOME=your_main_welcome_channel_id
# ROLE_MEMBER=your_member_role_id
# ROLE_CLAN_MEMBER_AS=your_clan_member_as_role_id
# ROLE_CLAN_MEMBER_EU=your_clan_member_eu_role_id
# SELFROLES_CHANNEL=your_selfroles_channel_id
# HORNET_GUILD_CONFIG_PATH=/path/to/guild.json
