# Discord Bot Environment Configuration Example
# Copy this file to .env and fill in your production values.
# Never commit a real .env — it holds the bot token and secrets.

# Discord Bot Credentials (required)
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
# REQUIRED — the bot owner's Discord user ID. There is no hardcoded
# fallback: if this is unset, owner-only commands have no owner
# (fail closed) and config.js logs an error at startup.
BOT_OWNER_ID=your_discord_user_id_here

# Guild Configuration
# Comma-separated guild IDs the bot is allowed to run in.
# Leave empty to allow all guilds (unrestricted).
ALLOWED_GUILD_IDS=id1,id2,id3

# Feature Flags (all default to true when unset)
ENABLE_TICKETS=true
ENABLE_TRYOUTS=true
ENABLE_VERIFICATION=true
ENABLE_MODERATION=true
ENABLE_CHANNEL_MANAGER=true
ENABLE_BROADCAST=true

# Database (required)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Cloudinary Image Hosting
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Folder prefix for uploaded images, e.g. "hornet/cards".
CLOUDINARY_FOLDER_PREFIX=hornet

# --- Guild channels, roles and clan branding ---
# These do NOT live in .env and do NOT need to be configured at all.
# The bot creates what it needs itself: run /setup once and it
# builds the HORNET category, every channel and every role, and
# remembers their IDs in MongoDB (BotSettings collection, see
# config/configLoader.js). /verification setup and /selfroles setup
# do the same for their own panel channel. A server that already has
# its own IDs in config/guild.json keeps using them — stored IDs are
# always tried first.
